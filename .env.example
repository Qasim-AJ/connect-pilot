# =============================================================================
# ConnectPilot - Environment Configuration (.env)
# Copy this file to `.env` and customize for your system:
#   cp .env.example .env      (macOS / Linux / Git Bash)
#   copy .env.example .env    (Windows PowerShell / CMD)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Authentication (Choose ONE method)
# -----------------------------------------------------------------------------
# Method A (Recommended): Dedicated Browser Profile Sign-In (Zero passwords stored!)
#   Run `python cli.py browser-login` (or `Sign_In_Once.bat` on Windows), sign into
#   LinkedIn once (works with Google SSO, Apple SSO, 2FA, Passkeys), then close the
#   browser window. Leave LINKEDIN_USERNAME, LINKEDIN_PASSWORD, and LI_AT_COOKIE blank.
#
# Method B: LinkedIn Session Cookie (Great for Google/Apple SSO without interactive window)
#   Open LinkedIn in your browser -> DevTools (F12) -> Application -> Cookies ->
#   https://www.linkedin.com -> copy the `li_at` value here:
LI_AT_COOKIE=

# Method C: Standard Email & Password
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Optional custom directory for encrypted credential storage (defaults to ~/.linkedin_bot/credentials)
CREDENTIALS_DIR=

# -----------------------------------------------------------------------------
# 2. Target Search Configuration
# -----------------------------------------------------------------------------
# Go to LinkedIn -> Search People -> apply filters (2nd/3rd degree, location, role)
# -> copy the full URL from your browser address bar and paste it here.
# Note: ConnectPilot automatically updates `page=N` in SEARCH_LINK after successful runs!
SEARCH_LINK=https://www.linkedin.com/search/results/people/?keywords=software%20engineer
SEARCH_KEYWORDS=software engineer

# -----------------------------------------------------------------------------
# 3. Connection Limits & Safety Pacing
# -----------------------------------------------------------------------------
# Keep limits conservative (10-20/day, 80-150/week) to protect your LinkedIn account.
MAX_CONNECT_REQUESTS_PER_SESSION=15
DAILY_CONNECTION_LIMIT=25
WEEKLY_CONNECTION_LIMIT=100
MAX_DAILY_REQUESTS=25
MAX_WEEKLY_REQUESTS=100

# Human-like delays between actions (in seconds)
MIN_DELAY=3.0
MAX_DELAY=8.0
PAGE_LOAD_DELAY=5.0

# -----------------------------------------------------------------------------
# 4. Browser & System Paths (Portable & Cross-Platform)
# -----------------------------------------------------------------------------
# Supported browsers: edge | chrome | firefox
BROWSER_TYPE=edge
HEADLESS=false
HEADLESS_MODE=false

# Dedicated persistent browser profile directory (relative paths resolve from repo root)
EDGE_USER_DATA_DIR=./edge_profile
EDGE_PROFILE_DIRECTORY=Default
CHROME_USER_DATA_DIR=./chrome_profile
CHROME_PROFILE_DIRECTORY=Default

# Optional: Custom browser binary paths (leave blank to auto-detect on Windows/macOS/Linux)
EDGE_BINARY_PATH=
CHROME_BINARY_PATH=
FIREFOX_BINARY_PATH=
GECKODRIVER_PATH=

# Optional: Attach to an already-running Edge instance instead of launching dedicated profile
# Leave blank for dedicated profile mode; set to `auto` (reads DevToolsActivePort) or `127.0.0.1:9223`
EDGE_DEBUGGER_ADDRESS=
EDGE_REMOTE_DEBUGGING_PORT=9223
EDGE_DEVTOOLS_ACTIVE_PORT_FILE=

# Local single-WebSocket CDP bridge settings (used when attaching to Edge 136+)
CDP_DAEMON_HOST=127.0.0.1
CDP_DAEMON_PORT=9229

# -----------------------------------------------------------------------------
# 5. Personalized Connection Note Settings
# -----------------------------------------------------------------------------
# Set SEND_WITH_NOTE=true to attach a personalized note, or false to click "Send without a note"
SEND_WITH_NOTE=false

# Separate multiple templates with `|` (ConnectPilot picks randomly and fills {name}, {title}, {company}, {location})
CONNECTION_MESSAGE_TEMPLATES=Hi {name}, I came across your profile and would love to connect!|Hello {name}, your work as {title} caught my attention—would love to add you to my professional network.

# -----------------------------------------------------------------------------
# 6. Storage, Sessions & Logging (Relative paths resolve from repo root)
# -----------------------------------------------------------------------------
DATABASE_PATH=data/bot.db
SESSION_DIR=sessions
SESSION_TIMEOUT_HOURS=24
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
ENABLE_SCREENSHOT_ON_ERROR=true

# -----------------------------------------------------------------------------
# 7. Anti-Detection & Optional Proxy
# -----------------------------------------------------------------------------
RANDOMIZE_USER_AGENT=true
RANDOMIZE_WINDOW_SIZE=true
USE_STEALTH_MODE=true

USE_PROXY=false
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
